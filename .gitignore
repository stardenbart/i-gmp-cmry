# Root .gitignore for MonitoringSystem

# Temporary office files
~$*

# Python & Report temp files
search_latency_report.json
frontend_search_latency_report.json

# IDEs and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Backend specific
backend/.env
backend/*.local.env
backend/bin/
backend/dist/
backend/uploads/
backend/logs/
backend/*.log
backend/vendor/
backend/docs/swagger/docs.go
backend/docs/swagger/swagger.json
backend/docs/swagger/swagger.yaml
backend/main
backend/server
backend/tmp_server
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Frontend specific (for future use)
node_modules/
dist/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


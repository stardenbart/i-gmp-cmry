# Copy to .env and replace every CHANGE_ME value before running Compose.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
DB_NAME=monitoring_audit
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_RANDOM_32_CHARS
SETTING_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX

# Session cookies (see backend/config/config.go). Access/refresh tokens are
# now delivered as httpOnly cookies, never in the JSON response body or
# localStorage.
#
# COOKIE_SECURE MUST be "true" on any deployment served over HTTPS — leave it
# there by default. Set it to "false" ONLY on a deployment that is genuinely
# plain HTTP with no TLS yet (e.g. accessed by bare IP, no reverse proxy in
# front): browsers silently DROP `Secure` cookies sent over plain HTTP, which
# breaks login completely (the response looks successful but no session
# cookie is ever stored). Flip it back to "true" the moment TLS is added
# (see docker-compose.proxy.yml) — never leave a real deployment on "false"
# longer than it takes to get a certificate.
COOKIE_SECURE=true
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Frontend HSTS (next.config.ts). Same rule as COOKIE_SECURE above: only ever
# "true" once this app is actually served over HTTPS — a browser that sees
# Strict-Transport-Security will refuse plain-HTTP connections to this host
# for the max-age duration, locking users out until TLS is live. Flip both
# this and COOKIE_SECURE together in the same deploy step.
ENABLE_HSTS=false

# Optional production operations settings.
# APP_IMAGE_TAG should normally be the deployed Git commit SHA.
APP_IMAGE_TAG=latest
LOG_LEVEL=info
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Optional HTTPS reverse proxy (docker-compose.proxy.yml).
APP_DOMAIN=audit.example.com
TLS_CONTACT_EMAIL=ops@example.com

# Required only when running the seed command.
SEED_ADMIN_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
SEED_AUDITOR_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
SEED_AUDITEE_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
SEED_SUPERVISOR_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
SEED_MANAGER_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
SEED_STAFF_PASSWORD=CHANGE_ME_RANDOM_32_CHARS

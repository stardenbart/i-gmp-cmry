# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
APP_NAME=MonitoringAudit
APP_ENV=development         # development | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_PORT=9000
APP_BASE_URL=http://localhost:9000

# ─────────────────────────────────────────────
# DATABASE (MySQL)
# ─────────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoring_audit
DB_USER=postgres
DB_PASSWORD=secret
DB_TIMEZONE=Asia/Jakarta
# disable | require | verify-ca | verify-full
# Use 'require' or 'verify-full' in production for TLS encryption in transit
DB_SSLMODE=disable

# ─────────────────────────────────────────────
# SMTP (Email Notifications)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER_EMAIL=noreply@monitoring-audit.local

# ─────────────────────────────────────────────
# MINIO (S3 Compatible Storage)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=monitoring-audit-bucket
MINIO_USE_SSL=false
MINIO_ALLOWED_IPS=127.0.0.1/32,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# Generate with: go run ./cmd/genkey/main.go
# This is a base64-encoded 32-byte AES-256 key for encrypting sensitive settings at rest
SETTING_ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# KAFKA & OPENSEARCH
# ─────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=monitoring-audit-group
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ─────────────────────────────────────────────
# JWT

# ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRED_HOURS=24

# ─────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────
STORAGE_DRIVER=local        # local | s3
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# LOGGER
# ─────────────────────────────────────────────
LOG_LEVEL=debug             # debug | info | warn | error
LOG_OUTPUT=console          # console | file
LOG_FILE_PATH=./logs/app.log

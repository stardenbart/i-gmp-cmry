// =========================================================
// ERD - SISTEM AUDIT INTERNAL
// Base: Inspection/Audit module (existing) 
// Tambahan: Role & Permission (configurable) + Logging
// Format: dbdiagram.io (DBML)
// Paste seluruh isi file ini ke https://dbdiagram.io
// =========================================================

//////////////////////////////////////////////////
// 1. MASTER ORGANISASI
//////////////////////////////////////////////////

Table Department_Master {
  DepartmentID varchar(20) [pk]
  DepartmentName varchar(100) // QC, QA, Produksi, dll
  DepartmentCreatedAt datetime
  DepartmentUpdatedAt datetime
  Note: 'Departemen: QC, QA, Produksi, dll'
}

Table Area_Master {
  AreaID varchar(20) [pk]
  AreaName varchar(100)
  AreaCreatedAt datetime
  AreaUpdatedAt datetime
}

Table Kawasan_Master {
  KawasanID varchar(20) [pk]
  AreaID varchar(20) [ref: > Area_Master.AreaID]
  KawasanName varchar(100)
  KawasanCreatedAt datetime
  KawasanUpdatedAt datetime
}

Table DetailKawasan_Master {
  DetailKawasanID varchar(20) [pk]
  KawasanID varchar(20) [ref: > Kawasan_Master.KawasanID]
  DetailKawasanName varchar(100)
  DetailKawasanCreatedAt  datetime
  DetailKawasanUpdatedAt  datetime
}

//////////////////////////////////////////////////
// 2. USER, ROLE & PERMISSION (CONFIGURABLE)
//////////////////////////////////////////////////

Table Users {
  UserID varchar(20) [pk]
  DepartmentID varchar(20) [ref: > Department_Master.DepartmentID]
  RoleID varchar(20) [ref: > Role_Master.RoleID]
  Username varchar(50) [unique]
  FullName varchar(100)
  Email varchar(100) [unique]
  PasswordHash varchar(255)
  UserStatus varchar(20) // Active, Inactive, Suspended
  UserCreatedAt datetime
  UserUpdatedAt datetime
  Note: 'Master user aplikasi. 1 user = 1 Role (many-to-one). Kolom PIC digabung langsung di sini, artinya 1 user hanya bisa jadi PIC untuk 1 Area/Kawasan.'
}

Table PIC_Mapping {
  PICMapID  varchar(20) [pk]
  AreaID  varchar(20) [ref: > Area_Master.AreaID]
  KawasanID varchar(20) [ref: > Kawasan_Master.KawasanID]
  UserID  varchar(20) [ref: > Users.UserID]
  KategoriPIC varchar(50)
  PICMappingCreatedAt datetime
  PICMappingUpdatedAt datetime
}

Table Role_Master {
  RoleID varchar(20) [pk]
  RoleName varchar(50) // Audit, Auditee, Admin, Supervisor, Manager, dll
  RoleDescription varchar(255)
  RoleCreatedAt datetime
  RoleUpdatedAt datetime
  Note: 'Role dasar: Audit, Auditee, Admin, Supervisor, Manager, dll. 1 Role dipakai banyak User, tapi 1 User cuma 1 Role.'
}

Table Module_Master {
  ModuleID varchar(20) [pk]
  ModuleName varchar(100) // Inspection, Issue, FollowUp, PIC Mapping, User Management, dll
  ModuleCreatedAt datetime
  ModuleUpdatedAt datetime
  Note: 'Daftar modul/menu dalam aplikasi, bisa ditambah manual'
}

Table Permission_Master {
  PermissionID varchar(20) [pk]
  ModuleID varchar(20) [ref: > Module_Master.ModuleID]
  PermissionCode varchar(50) // CREATE, READ, UPDATE, DELETE, APPROVE, EXPORT, dll
  PermissionName varchar(100)
  PermissionCreatedAt datetime
  PermissionUpdatedAt datetime
  Note: 'Daftar aksi/izin per modul, bisa ditambah manual sesuai kebutuhan'
}

Table Role_Permission {
  RolePermissionID varchar(20) [pk]
  RoleID varchar(20) [ref: > Role_Master.RoleID]
  PermissionID varchar(20) [ref: > Permission_Master.PermissionID]
  IsAllowed boolean [default: true]
  RolePermissionCreatedAt datetime
  RolePermissionUpdatedAt datetime
  RolePermissionUpdatedBy varchar(20) [ref: > Users.UserID]
  Note: 'Konfigurasi izin per role x per permission - inti dari Role Permission dinamis. Admin bisa menambah/mengubah kombinasi ini kapan saja tanpa ubah struktur tabel.'
}

//////////////////////////////////////////////////
// 3. MASTER AUDIT (ASPEK, DETAIL, URAIAN)
//////////////////////////////////////////////////

Table Aspek_Master {
  AspekID varchar(20) [pk]
  AreaID varchar(20) [ref: > Area_Master.AreaID]
  AspekName varchar(100)
  AspekCreatedAt datetime
  AspekUpdatedAt datetime
}

Table Detail_Master {
  DetailID varchar(20) [pk]
  AspekID varchar(20) [ref: > Aspek_Master.AspekID]
  DetailName varchar(150)
  DetailCreatedAt datetime
  DetailUpdatedAt datetime
}

Table Uraian_Master {
  UraianID varchar(20) [pk]
  DetailID varchar(20) [ref: > Detail_Master.DetailID]
  UraianText varchar(500)
  StandardScore int
  UraianCreatedAt datetime
  UraianUpdatedAt datetime
}

//////////////////////////////////////////////////
// 4. INSPECTION (HEADER & RESULT)
//////////////////////////////////////////////////

Table Inspection_Header {
  InspectionID varchar(20) [pk]
  AreaID varchar(20) [ref: > Area_Master.AreaID]
  KawasanID varchar(20) [ref: > Kawasan_Master.KawasanID]
  DetailKawasanID varchar(20) [ref: > DetailKawasan_Master.DetailKawasanID]
  InspectorID varchar(20) [ref: > Users.UserID]
  InspectionHeaderStatus varchar(30)
  InspectionHeaderCreatedAt datetime
  InspectionheaderUpdatedAt datetime
}

Table Inspection_Result {
  ResultID varchar(20) [pk]
  InspectionID varchar(20) [ref: > Inspection_Header.InspectionID]
  UraianID varchar(20) [ref: > Uraian_Master.UraianID]
  Checking varchar(20)
  Nilai int
  Keterangan varchar(255)
  InspectionResultCreatedAt datetime
  InspectionResultUpdatedAt datetime
}

//////////////////////////////////////////////////
// 5. ISSUE & FOLLOW UP
//////////////////////////////////////////////////

Table Issue {
  IssueID varchar(20) [pk]
  ResultID varchar(20) [ref: > Inspection_Result.ResultID]
  IssuePICUserID varchar(20) [ref: > Users.UserID]
  DueDate date
  IssueStatus varchar(30)
  Keterangan varchar(255)
  IssueCreatedAt datetime
  IssueUpdatedAt datetime
}

Table Issue_Photo {
  IssuePhotoID varchar(20) [pk]
  IssueID varchar(20) [ref: > Issue.IssueID]
  PICUserID varchar(20) [ref: > Users.UserID]
  PhotoType varchar(20) // 'Initial' = foto awal temuan, 'FollowUp' = foto bukti tindak lanjut
  ImageUrl varchar(255)
  FileName varchar(255)
  FollowUpDate date // hanya diisi jika PhotoType = 'FollowUp'
  JumlahFollowUp int // hanya diisi jika PhotoType = 'FollowUp', ke berapa kali follow up
  PhotoCreatedAt datetime
  PhotoUpdatedAt datetime
  Note: 'Gabungan Dim_Issue + Issue_FollowUp. Satu tabel untuk semua lampiran foto Issue, dibedakan lewat PhotoType.'
}

//////////////////////////////////////////////////
// 7. LOGGING MANAGEMENT
//////////////////////////////////////////////////

Table Login_Log {
  LoginLogID varchar(20) [pk]
  UserID varchar(20) [ref: > Users.UserID]
  LoginAt datetime
  LogoutAt datetime
  IPAddress varchar(50)
  DeviceInfo varchar(255)
  LoginStatus varchar(20) // Success, Failed
  Note: 'Khusus mencatat aktivitas login/logout user'
}

Table Activity_Log {
  ActivityLogID varchar(20) [pk]
  UserID varchar(20) [ref: > Users.UserID]
  ModuleID varchar(20) [ref: > Module_Master.ModuleID]
  PermissionID varchar(20) [ref: > Permission_Master.PermissionID]
  ActivityAction varchar(50) // CREATE, UPDATE, DELETE, APPROVE, EXPORT, dll
  TableAffected varchar(100)
  RecordID varchar(50)
  OldValue text
  NewValue text
  ActivityDescription varchar(255)
  IPAddress varchar(50)
  ActivityCreatedAt datetime
  Note: 'Mencatat semua aksi CRUD/perubahan data di semua modul untuk keperluan audit trail'
}
